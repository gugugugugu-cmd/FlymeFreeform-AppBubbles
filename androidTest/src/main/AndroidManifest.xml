<?xml version="1.0" encoding="utf-8"?>
<!--
  阶段 5 的 IPC 安全验证夹具。独立模块，不进主 APK。

  注意：这里**不声明 instrument**。
  第一版用 instrumentation 加载主模块包作为目标，会把主模块的 Xposed 入口
  在一个没有 module 实例的进程里跑起来，导致进程直接崩溃（详见 ForgeActivity 注释）。
  现在只有一个 Activity，启动即发广播。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="FlymeFreeform Forge"
        android:supportsRtl="true">

        <activity
            android:name=".ForgeActivity"
            android:exported="true"
            android:label="FlymeFreeform Forge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
